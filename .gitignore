# ------------------------------------------------------------------------------
# ThreatWeave .gitignore
# ------------------------------------------------------------------------------

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment Configuration (Always ignore local secrets!)
.env
.env.*
!.env.example
.env.local
.env.prod
.env.development.local
.env.test.local
.env.production.local

# Python - Dependency and Virtual Environments
venv/
.venv/
env/
.env/
ENV/
pyvenv.cfg
pip-log.txt
pip-delete-this-directory.txt

# Python - Caching, Builds, and Test Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python build libraries
lib/
!apps/web/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js - Dependency and Build Folders (Next.js)
node_modules/
.next/
out/
dist-web/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# Local Databases and Persistent Storage Directories
chroma_db/
postgres_data/
chromadb_data/
storage/
apps/api/storage/
scratch/
*/scratch/
apps/api/scratch/
scratch_verify*.py
*.db
*.sqlite

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ------------------------------------------------------------------------------
# ThreatWeave Environment Variables Config (Example Template)
# Copy this file to '.env' at the root of the project and configure the values.
# Do NOT commit the '.env' file containing real secrets to version control.
# ------------------------------------------------------------------------------

# Application General Config
ENVIRONMENT=development
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_USER=threatweave_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=threatweave_db
POSTGRES_PORT=5432

# Database Connection URL (used by SQLAlchemy/Alembic in apps/api)
DATABASE_URL=postgresql://threatweave_user:your_secure_postgres_password_here@localhost:5432/threatweave_db

# Vector Database (ChromaDB) Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PATH=./chroma_db
RAG_SIMILARITY_THRESHOLD=0.40
RAG_TOP_K=5

# Agent APIs (Mandatory for core agents)
GROQ_API_KEY=your_groq_api_key_here

# Optional Agent Extensions
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Multimodal Storage & Ingestion Validation Limits
STORAGE_PATH=./storage
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=15
MAX_TEXT_CHARS=20000

# Text Agent configurations
# Model: openai/gpt-oss-120b (Groq API, JSON mode, fast structured threat analysis)
TEXT_AGENT_MODEL=openai/gpt-oss-120b
TEXT_AGENT_TIMEOUT=30

# URL Agent configurations (Phase 6)
# URL_REPUTATION_API_KEY — OPTIONAL. Leave empty (or omit entirely) to run
# the URL Agent in heuristics-only mode with NO network calls to any external
# reputation service. Set this to a valid API key only when you have integrated
# a concrete provider (e.g. VirusTotal, URLScan.io).
URL_REPUTATION_API_KEY=

# Timeout in seconds for the optional URL reputation API call.
# Only used when URL_REPUTATION_API_KEY is set above.
URL_REPUTATION_API_TIMEOUT_SECONDS=8

# n8n Workflow Automation Integration (Phase 16)
# Port for local n8n service
N8N_PORT=5678
# Webhook URL to notify on high/critical severity investigations.
# Leave empty to disable automated webhook dispatches (graceful degradation, zero network calls).
N8N_WEBHOOK_URL=
# Minimum severity threshold required to trigger the n8n webhook ("high" or "critical")
N8N_ALERT_SEVERITY_THRESHOLD=high
# n8n Optional Basic Authentication (for local container)
N8N_BASIC_AUTH_PASSWORD=admin_secure_password_here

# Auth & JWT Configuration (Phase 17)
# For development, defaults are provided. In staging/production, JWT_SECRET_KEY MUST be set to a strong random secret.
JWT_SECRET_KEY=threatweave-dev-secret-key-change-in-prod
JWT_EXPIRY_MINUTES=1440
JWT_ALGORITHM=HS256
